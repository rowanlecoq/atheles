# Discord Bot
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id
DISCORD_GUILD_ID=your_server_id

# Must match DISCORD_SYNC_SECRET in the website's .env
DISCORD_SYNC_SECRET=a_random_secret_string

# The deployed website URL (no trailing slash)
WEBSITE_URL=https://atheles.com

# Discord role IDs — create one role per tier in your server, copy the IDs here
# Right-click a role → Copy Role ID (requires Developer Mode)
DISCORD_ROLE_BRONZE=
DISCORD_ROLE_SILVER=
DISCORD_ROLE_GOLD=
DISCORD_ROLE_PLATINUM=
DISCORD_ROLE_CHAMPION=
DISCORD_ROLE_ATHLETE=
DISCORD_ROLE_ADMIN=
